#include <windows.h>
#include "resource.h"

IDR_MYMENU MENU
BEGIN
    POPUP "Menu"
    BEGIN
        MENUITEM "Task 1", IDM_WORK1
        MENUITEM "Task 2", IDM_WORK2
        MENUITEM SEPARATOR
        MENUITEM "Exit", IDM_EXIT
    END
END

IDD_DIALOG1 DIALOGEX 0, 0, 240, 90
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Input Text (Task 1)"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Enter text:", -1, 10, 15, 100, 12
    EDITTEXT        IDC_EDIT1, 10, 30, 220, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 110, 60, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 170, 60, 50, 14
END

IDD_DIALOG2 DIALOGEX 0, 0, 240, 90
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select Number (Task 2)"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Selected: 50", IDC_STATIC_TEXT, 10, 15, 200, 12
    SCROLLBAR       IDC_SCROLLBAR1, 10, 32, 220, 11, SBS_HORZ
    DEFPUSHBUTTON   "OK", IDOK, 110, 60, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 170, 60, 50, 14
END
